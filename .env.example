# --- Приложение -------------------------------------------------------------
# Node 22.13 или новее. Ниже сервис не запустится: требование зафиксировано
# в package.json (engines), и понижать его ради совместимости не стоит.
# PORT
PORT=3001

# 0.0.0.0 обязателен: с loopback сервис работает локально и молча недоступен
# в контейнере.
HOST=0.0.0.0

# --- Рынок -----------------------------------------------------------------
# binance — боевой провайдер; bitget — резервный; mock — детерминированные
# данные для разработки и тестов (close = 100000 + i).
MARKET_PROVIDER=binance
MARKET_BASE_URL=https://data-api.binance.vision
MARKET_SYMBOL=BTCUSDT
# Рынки, которые процесс наблюдает, кроме основного: MARKET_SYMBOLS=ETHUSDT
# Задавать нужно **обе** настройки. MARKET_SYMBOLS говорит, что наблюдать, а
# MARKET_VENUE_CAPABILITIES ниже — какая площадка за какой рынок отвечает, и
# без неё процесс не стартует: рынок, который никто не объявил, это ошибка
# развёртывания, а не повод падать на каждом тике. Формат:
# `площадка=ТИКЕРЫ@интервалы`, записи через `;`, тикеры через запятую.
# Пусто (по умолчанию) — наблюдается только MARKET_SYMBOL, и объявлять нечего.
# MARKET_SYMBOLS=
# ASSET_REGISTRY replaces the built-in asset/quote-currency registry with JSON.
# ASSET_REGISTRY={"assets":[{"symbol":"BTC","name":"Bitcoin","category":"crypto"}],"quoteCurrencies":["USDT"]}
MARKET_CANDLE_INTERVAL=1h
# Резервные биржи через запятую, в порядке предпочтения. Пустое значение — работать
# без резерва. Переключение происходит внутри одного запроса, а не после всех
# повторов основной биржи. Значение mock здесь запрещено: тестовая заглушка,
# подменившая настоящую биржу, выдала бы выдуманные цены на панели.
MARKET_FALLBACK_PROVIDERS=bitget
MARKET_FALLBACK_BASE_URL=https://api.bitget.com
# Тикер резерва. Задавать нужно только вместе с MARKET_FALLBACK_PROVIDERS, и
# только равным MARKET_SYMBOL: подмена рынка резервом не поддерживается и
# отвергается при старте. Резерв — это второй источник того же рынка, а не
# замена основному тикеру, когда пара не листится на всех биржах.
MARKET_FALLBACK_SYMBOL=BTCUSDT
# Что каждая площадка обслуживает. Не задано — выводится из MARKET_SYMBOL и
# MARKET_FALLBACK_SYMBOL, и этого достаточно для одного рынка. Задавать нужно
# тогда, когда рынков больше одного или площадка отвечает не за свой тикер:
# MARKET_VENUE_CAPABILITIES=binance=BTCUSDT@1h;bitget=BTCUSDT,ETHUSDT@1h
# Цепочка отказоустойчивости строится по этой таблице, а не по списку резервов.
# Процесс отказывается стартовать, если настроенный рынок не объявлен ни одной
# площадкой, и в отказе перечисляет, что объявлено на самом деле. Отказ есть и
# на резерв, который не объявляет основной рынок на интервале MARKET_CANDLE_INTERVAL.
# MARKET_VENUE_CAPABILITIES=
# Нижняя граница запроса свечей. На практике её перекрывает requiredCandleCount
# из конфигурации индикаторов (900), поэтому число ниже 900 ни на что не
# влияет — оставлено для явности.
MARKET_DEFAULT_CANDLE_LIMIT=900
MARKET_REQUEST_TIMEOUT_MS=10000
MARKET_USER_AGENT=BuyNotBuy.com/1.0 (+https://buynotbuy.com)

# Кэш снимка. TTL — как долго снимок считается свежим; max stale — как долго
# он всё ещё отдаётся, когда провайдер недоступен.
MARKET_CACHE_TTL_MS=60000
MARKET_MAX_STALE_MS=3600000

# Повторы и защита от лавины запросов.
MARKET_MAX_RETRIES=2
MARKET_RETRY_BASE_DELAY_MS=250
MARKET_RETRY_MAX_DELAY_MS=5000
MARKET_CIRCUIT_FAILURE_THRESHOLD=5
MARKET_CIRCUIT_COOLDOWN_MS=30000
MARKET_MAX_RETRY_AFTER_MS=120000
MARKET_PROVIDER_DEGRADED_AFTER_MS=300000
MARKET_PROVIDER_LATENCY_SAMPLE_SIZE=512
MARKET_BACKFILL_FROM=1509600000000
MARKET_BACKFILL_PAGE_SIZE=1000
MARKET_BACKFILL_PAGE_DELAY_MS=1000

# --- Сеть и безопасность ---------------------------------------------------
# 16 КБ: API ничего не принимает, и большие тела должны отсекаться до
# роутера.
APP_BODY_LIMIT_BYTES=16384
APP_CONNECTION_TIMEOUT_MS=10000

# Лимит Fastify на получение полного запроса от клиента; он не ограничивает
# выполнение маршрута или запросы к провайдерам рынка.
APP_REQUEST_TIMEOUT_MS=60000
APP_KEEPALIVE_TIMEOUT_MS=5000

# По умолчанию 300 запросов в минуту на адрес.
APP_RATE_LIMIT_MAX=300
APP_RATE_LIMIT_WINDOW_MS=60000

# Список через запятую. Пусто — не открывать доступ из браузера вовсе, что и
# нужно: панель обращается к бэкенду с сервера.
APP_CORS_ORIGINS=

# HSTS включается только за TLS-прокси: в HTTP браузер его игнорирует, а
# закрепление localhost мешает разработке.
APP_HSTS_MAX_AGE=0

# Включайте только если перед сервисом есть прокси, который перезаписывает
# X-Forwarded-For. Иначе любой клиент назовёт себе новый адрес и пройдёт мимо
# лимита частоты.
APP_TRUST_PROXY=false

# --- База данных -----------------------------------------------------------
# PostgreSQL 13 или новее. Одна строка подключения вместо пяти переменных:
# хост, порт, пользователь, пароль и имя базы ходят вместе, а наполовину
# заполненный набор (пароль без базы) обнаруживается уже во время запроса,
# вдали от причины.
#
# Пароль в .env — это пароль от роли приложения, а не от суперпользователя.
# Роли достаточно прав на своей базе и ничего больше.
DATABASE_URL=postgresql://buynotbuy:buynotbuy@localhost:5432/buynotbuy

# Соединений в пуле. Сервис — это один фоновый опрос плюс загрузки страниц,
# поэтому пул заметно больше нужного не используется, а стоит дорого: каждое
# соединение это процесс на стороне PostgreSQL, и пул шире max_connections
# превращает минуту нагрузки в отказ в соединении.
DB_POOL_MAX=10

# Сколько соединение может простаивать перед закрытием. Короткий срок нужен
# для того, чтобы перезапуск базы переживался новым соединением, а не пулом
# из мёртвых сокетов.
DB_IDLE_TIMEOUT_MS=30000

# Сколько можно устанавливать одно соединение. Без этого недоступная база
# держит первый запрос до тех пор, пока не откажется операционная система.
DB_CONNECT_TIMEOUT_MS=5000

# Потолок одной SQL-команды. Именно он освобождает соединение из пула, а не
# клиентский таймаут: клиентский прекратил бы только ждать, а команда
# продолжала бы выполняться на сервере.
DB_STATEMENT_TIMEOUT_MS=10000

# Потолок ожидания блокировки. Отделён от потолка команды, потому что это
# разные отказы: здесь кто-то пишет прямо сейчас и ответ — «повторить
# позже», который умеет повторять буфер записи.
DB_LOCK_TIMEOUT_MS=5000

# Имя приложения в pg_stat_activity, чтобы медленный запрос был опознаваем.
DB_APPLICATION_NAME=buynotbuy

# --- История сигналов -------------------------------------------------------
# Сколько записей отдавать по умолчанию, сколько максимум за раз запрос и
# сколько хранить. Запись почасовая, поэтому 720 — это 30 суток.
HISTORY_DEFAULT_LIMIT=24
HISTORY_MAX_LIMIT=168
HISTORY_MAX_ENTRIES=720

# Сколько неудачных записей держать для повтора. Ограничено намеренно.
HISTORY_MAX_BUFFERED_ENTRIES=24

# --- Фоновый опрос ---------------------------------------------------------
# Именно он пишет историю, когда панель никто не открывает, и держит кэш
# тёплым. Выключайте в разовых скриптах: таймер не даст процессу завершиться.
MARKET_POLL_ENABLED=true
MARKET_POLL_INTERVAL_MS=60000

# --- Persistent write spool ---------------------------------------------------
WRITE_SPOOL_ENABLED=true
WRITE_SPOOL_DIR=./data/spool
WRITE_SPOOL_MAX_BYTES=33554432

# --- Наблюдаемость ----------------------------------------------------------
# Заголовок, из которого берётся идентификатор запроса. Только из заголовка:
# параметр в строке запроса попадает в чужие журналы по дороге.
OBSERVABILITY_REQUEST_ID_HEADER=x-request-id

# Слишком длинный идентификатор отбрасывается, а не обрезается: обрезанный не
# найдётся при поиске, и перенос строки в нём подделал бы строку журнала.
OBSERVABILITY_REQUEST_ID_MAX_LENGTH=128

# Предел серий на группу метрик. Лишние адреса маршрутов и коды ответов в счёт
# не идут — иначе каждое новое значение создавало бы вечную серию.
OBSERVABILITY_METRIC_LABEL_LIMIT=32

# --- Performance reports ------------------------------------------------------
PERFORMANCE_MINIMUM_SAMPLE=20
PERFORMANCE_CONFIDENCE_EDGES=0,25,40,55,70,85,100
PERFORMANCE_REPORT_UNSAMPLED=true

# --- Strategy profile ----------------------------------------------------------
# Signal behavior is selected as one validated profile; see docs/configuration.md.
STRATEGY_PROFILE=baseline

# --- Фронтенд --------------------------------------------------------------
# Адрес бэкенда, к которому серверные компоненты Next обращаются.
BACKEND_URL=http://localhost:3001
