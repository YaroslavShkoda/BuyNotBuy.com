# Staging configuration overlay
#
# Base: copy `.env.example` and set its values first. This file is the
# STAGING DELTA on top of it - the settings that must differ from a developer
# defaults file, and the one line that makes a running instance prove which
# commit it serves. Never put a production secret in this file, and never
# point any staging value at a production database.
#
# Generate the staging password per install; do not ship one in a repository:
#   DATABASE_URL=postgresql://buynotbuy_staging:<generated>@<staging-host>:<port>/buynotbuy_staging
#
# The application role is created without DDL rights; migrations run once
# through a separate privileged step (see docs/staging.md, "Migration dry-run").

# --- Provenance ----------------------------------------------------------------
# The pinned commit this deployment serves. /healthz echoes it back, so an
# operator - or a rollback - can always answer "what is actually running".
DEPLOY_SHA=

# --- Network posture -----------------------------------------------------------
# Staging states its own dashboard origin instead of the empty default; the
# loopback bind below keeps the instance unreachable until that origin exists.
HOST=127.0.0.1
APP_CORS_ORIGINS=https://staging.buynotbuy.example
# TLS terminates at the proxy in front of staging, so HSTS is on here - unlike
# the developer default, which leaves it off for plain-local HTTP.
APP_HSTS_MAX_AGE=31536000
# A lower abuse budget than production's: staging is not the product.
APP_RATE_LIMIT_MAX=120

# --- Market configuration ------------------------------------------------------
# Staging rehearses the documented activation state exactly as
# docs/ethusdt-activation.md writes it, before production repeats it.
MARKET_SYMBOLS=ETHUSDT
MARKET_VENUE_CAPABILITIES=binance=BTCUSDT,ETHUSDT@1h;bitget=BTCUSDT,ETHUSDT@1h
