* {
    box-sizing: border-box;
}

html {
    margin: 0;
    padding: 0;
    background: #050505;
    color-scheme: dark;
}

body {
    margin: 0;
    padding: 0;
    min-width: 320px;
    background:
        radial-gradient(
            circle at 50% -10%,
            rgba(255, 255, 255, 0.055),
            transparent 34%
        ),
        radial-gradient(
            circle at 90% 35%,
            rgba(90, 140, 255, 0.035),
            transparent 28%
        ),
        #050505;
    color: #f5f5f5;
    font-family: Arial, sans-serif;
    font-weight: 300;
    -webkit-font-smoothing: antialiased;
}

body::before {
    content: "";
    position: fixed;
    inset: 0;
    pointer-events: none;
    z-index: -1;
    background-image:
        linear-gradient(
            rgba(255,255,255,0.012) 1px,
            transparent 1px
        ),
        linear-gradient(
            90deg,
            rgba(255,255,255,0.012) 1px,
            transparent 1px
        );
    background-size: 64px 64px;
    mask-image: linear-gradient(
        to bottom,
        black,
        transparent 80%
    );
}

button {
    font: inherit;
}

main {
    width: min(1500px, calc(100% - 64px));
    margin: 0 auto;
    padding: 34px 0 80px;
}

/* =========================================================
   GLOBAL SURFACE SYSTEM
   ========================================================= */

.topbar,
.hero,
.lower-grid > article,
.lower-grid > section,
section {
    position: relative;
    border: 1px solid rgba(255, 255, 255, 0.095);
    background:
        linear-gradient(
            145deg,
            rgba(255,255,255,0.052),
            rgba(255,255,255,0.018) 48%,
            rgba(255,255,255,0.012)
        );
    box-shadow:
        0 30px 80px rgba(0, 0, 0, 0.58),
        0 8px 28px rgba(0, 0, 0, 0.32),
        inset 0 1px 0 rgba(255,255,255,0.075),
        inset 0 -1px 0 rgba(0,0,0,0.45);
    backdrop-filter: blur(18px);
    -webkit-backdrop-filter: blur(18px);
}

.topbar::before,
.hero::before,
.lower-grid > article::before,
.lower-grid > section::before {
    content: "";
    position: absolute;
    left: 12%;
    right: 12%;
    top: 0;
    height: 1px;
    background: linear-gradient(
        90deg,
        transparent,
        rgba(255,255,255,0.18),
        transparent
    );
    pointer-events: none;
}

.topbar {
    min-height: 92px;
    margin-bottom: 26px;
    padding: 18px 24px;
    border-radius: 24px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    overflow: hidden;
}

.topbar::after,
.hero::after,
.lower-grid > article::after {
    content: "";
    position: absolute;
    width: 240px;
    height: 240px;
    right: -120px;
    top: -120px;
    border-radius: 50%;
    background: rgba(255,255,255,0.018);
    filter: blur(20px);
    pointer-events: none;
}

/* =========================================================
   BRAND
   ========================================================= */

.brand {
    display: flex;
    align-items: center;
    gap: 16px;
}

.logo-wrap {
    width: 58px;
    height: 58px;
    border-radius: 17px;
    display: grid;
    place-items: center;
    background:
        linear-gradient(
            145deg,
            rgba(255,255,255,0.10),
            rgba(255,255,255,0.025)
        );
    border: 1px solid rgba(255,255,255,0.11);
    box-shadow:
        inset 0 1px 0 rgba(255,255,255,0.12),
        0 12px 30px rgba(0,0,0,0.45);
}

.logo {
    width: 44px;
    height: 44px;
    object-fit: contain;
}

.brand h1 {
    margin: 0;
    font-size: 22px;
    font-weight: 300;
    letter-spacing: -0.02em;
}

.brand p {
    margin: 5px 0 0;
    color: #777;
    font-size: 11px;
    letter-spacing: 0.18em;
    text-transform: uppercase;
}

.pair {
    display: flex;
    align-items: center;
    gap: 12px;
}

.pair strong {
    font-size: 14px;
    font-weight: 400;
    letter-spacing: 0.08em;
}

.pair small {
    padding: 5px 8px;
    border-radius: 7px;
    color: #777;
    border: 1px solid rgba(255,255,255,0.08);
    background: rgba(255,255,255,0.025);
    font-size: 9px;
    letter-spacing: 0.14em;
}

.settings-button {
    padding: 10px 15px;
    border-radius: 10px;
    color: #888;
    border: 1px solid rgba(255,255,255,0.08);
    background: rgba(255,255,255,0.025);
    font-size: 10px;
    letter-spacing: 0.16em;
    transition:
        color 180ms ease,
        border-color 180ms ease,
        background 180ms ease,
        transform 180ms ease;
}

.settings-button:hover {
    color: #fff;
    border-color: rgba(255,255,255,0.18);
    background: rgba(255,255,255,0.055);
    transform: translateY(-1px);
}

/* =========================================================
   HERO
   ========================================================= */

.hero {
    display: grid;
    grid-template-columns: minmax(0, 1.65fr) minmax(320px, 0.8fr);
    gap: 1px;
    padding: 0;
    overflow: hidden;
    min-height: 590px;
    border-radius: 30px;
    margin-bottom: 22px;
}

.price-panel,
.signal-panel {
    position: relative;
    min-width: 0;
}

.price-panel {
    padding: 34px;
    background:
        radial-gradient(
            circle at 30% 40%,
            rgba(255,255,255,0.035),
            transparent 38%
        );
}

.signal-panel {
    padding: 34px;
    border-left: 1px solid rgba(255,255,255,0.07);
    background:
        radial-gradient(
            circle at 50% 20%,
            rgba(255,255,255,0.025),
            transparent 42%
        );
}

.hero-top,
.panel-heading,
.section-title {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
}

.pair-label {
    display: flex;
    align-items: center;
    gap: 12px;
}

.pair-label strong {
    font-size: 13px;
    font-weight: 400;
    letter-spacing: 0.12em;
}

.pair-label span {
    color: #666;
    font-size: 9px;
    letter-spacing: 0.16em;
}

.provider {
    display: flex;
    align-items: center;
    gap: 10px;
    color: #666;
    font-size: 9px;
    letter-spacing: 0.14em;
}

.live-pill {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    padding: 6px 9px;
    border: 1px solid rgba(95, 210, 150, 0.2);
    border-radius: 999px;
    color: #91d8b2;
    background: rgba(95, 210, 150, 0.045);
}

.live-pill i,
.system-list i {
    display: inline-block;
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: #72d49b;
    box-shadow: 0 0 12px rgba(114,212,155,0.7);
}

.price {
    display: flex;
    align-items: baseline;
    gap: 10px;
    margin-top: 52px;
}

.price span {
    color: #666;
    font-size: 24px;
    font-weight: 300;
}

.price strong {
    font-size: clamp(52px, 6vw, 82px);
    line-height: 0.95;
    font-weight: 300;
    letter-spacing: -0.045em;
    text-shadow: 0 8px 30px rgba(255,255,255,0.08);
}

.price-subtitle {
    display: flex;
    gap: 20px;
    margin-top: 16px;
    color: #666;
    font-size: 9px;
    letter-spacing: 0.2em;
}

.chart-placeholder,
.market-chart {
    position: relative;
    min-height: 255px;
    margin-top: 40px;
    border-radius: 20px;
    overflow: hidden;
    border: 1px solid rgba(255,255,255,0.065);
    background:
        linear-gradient(
            180deg,
            rgba(255,255,255,0.025),
            rgba(255,255,255,0.008)
        );
    box-shadow:
        inset 0 1px 0 rgba(255,255,255,0.035),
        inset 0 -30px 60px rgba(0,0,0,0.18);
}

.chart-grid {
    position: absolute;
    inset: 0;
    opacity: 0.5;
    background-image:
        linear-gradient(
            rgba(255,255,255,0.035) 1px,
            transparent 1px
        ),
        linear-gradient(
            90deg,
            rgba(255,255,255,0.035) 1px,
            transparent 1px
        );
    background-size: 70px 50px;
}

.chart-message {
    position: absolute;
    inset: 0;
    display: grid;
    place-content: center;
    text-align: center;
    color: #777;
    font-size: 10px;
    letter-spacing: 0.2em;
}

.chart-message small {
    display: block;
    margin-top: 8px;
    color: #444;
    font-size: 8px;
}

.timeframes {
    display: flex;
    gap: 7px;
    margin-top: 18px;
}

.timeframes button {
    min-width: 48px;
    padding: 9px 12px;
    border: 1px solid rgba(255,255,255,0.065);
    border-radius: 9px;
    color: #666;
    background: rgba(255,255,255,0.018);
    cursor: pointer;
    transition: all 180ms ease;
}

.timeframes button:hover,
.timeframes button.selected {
    color: #fff;
    border-color: rgba(255,255,255,0.16);
    background: rgba(255,255,255,0.065);
}

.last-update {
    display: flex;
    justify-content: space-between;
    margin-top: 18px;
    color: #555;
    font-size: 9px;
    letter-spacing: 0.12em;
}

.last-update strong {
    color: #777;
    font-weight: 300;
}

/* =========================================================
   SIGNAL
   ========================================================= */

.signal-panel.long {
    background:
        radial-gradient(
            circle at 50% 30%,
            rgba(90,210,145,0.075),
            transparent 48%
        );
}

.signal-panel.short {
    background:
        radial-gradient(
            circle at 50% 30%,
            rgba(225,100,110,0.075),
            transparent 48%
        );
}

.panel-heading {
    color: #777;
    font-size: 10px;
    letter-spacing: 0.18em;
}

.panel-heading small,
.section-title small {
    color: #444;
    font-size: 10px;
}

.signal-panel > .signal,
.signal {
    margin-top: 95px;
    display: block;
    font-size: clamp(48px, 6vw, 76px);
    line-height: 1;
    font-weight: 300;
    letter-spacing: -0.04em;
}

.signal-panel.long .signal,
.long {
    color: #9ae0b8;
    text-shadow: 0 0 35px rgba(90,210,145,0.16);
}

.signal-panel.short .signal,
.short {
    color: #e39a9f;
    text-shadow: 0 0 35px rgba(225,100,110,0.14);
}

.signal-panel.neutral .signal,
.neutral {
    color: #d0d0d0;
}

.signal-panel > p {
    max-width: 340px;
    margin: 18px 0 0;
    color: #666;
    line-height: 1.7;
    font-size: 12px;
}

.confidence {
    margin-top: 46px;
}

.confidence > div:first-child {
    display: flex;
    justify-content: space-between;
    color: #666;
    font-size: 9px;
    letter-spacing: 0.16em;
}

.confidence-bar {
    height: 5px;
    margin-top: 12px;
    border-radius: 999px;
    overflow: hidden;
    background: rgba(255,255,255,0.06);
}

.confidence-bar > div {
    height: 100%;
    border-radius: inherit;
    background: linear-gradient(
        90deg,
        rgba(255,255,255,0.2),
        rgba(255,255,255,0.8)
    );
    box-shadow: 0 0 16px rgba(255,255,255,0.14);
}

/* =========================================================
   LOWER GRID
   ========================================================= */

.lower-grid {
    display: grid;
    grid-template-columns: 1.15fr 0.85fr;
    gap: 22px;
}

.lower-grid > article {
    border-radius: 24px;
    padding: 28px;
    overflow: hidden;
    min-height: 270px;
    transition:
        transform 220ms ease,
        border-color 220ms ease,
        box-shadow 220ms ease;
}

.lower-grid > article:hover {
    transform: translateY(-2px);
    border-color: rgba(255,255,255,0.14);
    box-shadow:
        0 34px 90px rgba(0,0,0,0.62),
        0 10px 30px rgba(0,0,0,0.35),
        inset 0 1px 0 rgba(255,255,255,0.08);
}

.section-title {
    margin-bottom: 28px;
}

.section-title strong {
    display: block;
    margin-top: 7px;
    color: #ddd;
    font-size: 12px;
    font-weight: 400;
    letter-spacing: 0.14em;
}

.breakdown-list {
    display: grid;
    gap: 2px;
}

.breakdown-row {
    display: grid;
    grid-template-columns: 30px minmax(130px, 1fr) 100px 90px;
    align-items: center;
    gap: 16px;
    min-height: 70px;
    padding: 8px 0;
    border-top: 1px solid rgba(255,255,255,0.045);
}

.row-number {
    color: #3d3d3d;
    font-size: 10px;
}

.row-name strong {
    display: block;
    color: #bbb;
    font-size: 11px;
    font-weight: 400;
}

.row-name span {
    display: block;
    margin-top: 6px;
    color: #555;
    font-size: 9px;
}

.row-progress {
    height: 4px;
    overflow: hidden;
    border-radius: 999px;
    background: rgba(255,255,255,0.045);
}

.row-progress > div {
    width: 72%;
    height: 100%;
    border-radius: inherit;
    background: linear-gradient(
        90deg,
        rgba(255,255,255,0.15),
        rgba(255,255,255,0.65)
    );
}

.row-result {
    display: flex;
    justify-content: flex-end;
    align-items: center;
    gap: 10px;
}

.row-result span {
    font-size: 9px;
    letter-spacing: 0.12em;
}

.row-result strong {
    color: #666;
    font-size: 10px;
    font-weight: 300;
}

/* =========================================================
   SYSTEM
   ========================================================= */

.system-list {
    display: grid;
    gap: 2px;
}

.system-list > div {
    display: flex;
    align-items: center;
    justify-content: space-between;
    min-height: 58px;
    padding: 0 2px;
    border-top: 1px solid rgba(255,255,255,0.045);
}

.system-list span {
    display: flex;
    align-items: center;
    gap: 10px;
    color: #777;
    font-size: 10px;
}

.system-list strong {
    color: #aaa;
    font-size: 9px;
    font-weight: 400;
    letter-spacing: 0.12em;
}

.system-list > div:last-child i {
    background: #d2a86e;
    box-shadow: 0 0 12px rgba(210,168,110,0.55);
}

.system-list > div:last-child strong {
    color: #b59667;
}

/* =========================================================
   NEWS
   ========================================================= */

.news-card {
    grid-column: 1 / -1;
    min-height: 220px !important;
}

.news-card > .section-title > span {
    color: #555;
    font-size: 9px;
    letter-spacing: 0.15em;
}

.news-content {
    min-height: 110px;
    display: flex;
    align-items: center;
    gap: 24px;
    padding: 20px;
    border-radius: 18px;
    border: 1px solid rgba(255,255,255,0.045);
    background:
        linear-gradient(
            135deg,
            rgba(255,255,255,0.028),
            rgba(255,255,255,0.008)
        );
}

.news-icon {
    width: 54px;
    height: 54px;
    display: grid;
    place-items: center;
    flex: 0 0 auto;
    border-radius: 16px;
    color: #aaa;
    border: 1px solid rgba(255,255,255,0.08);
    background: rgba(255,255,255,0.025);
    font-size: 22px;
}

.news-content span {
    color: #555;
    font-size: 9px;
    letter-spacing: 0.16em;
}

.news-content strong {
    display: block;
    margin-top: 7px;
    color: #bbb;
    font-size: 15px;
    font-weight: 300;
}

.news-content p {
    margin: 7px 0 0;
    color: #555;
    font-size: 11px;
}

/* =========================================================
   TECHNICAL / PULSE / ACTIVITY COMPONENTS
   ========================================================= */

.technical-analysis,
.market-pulse,
.market-activity,
.market-intelligence {
    position: relative;
    border-radius: 24px;
    border: 1px solid rgba(255,255,255,0.085);
    background:
        linear-gradient(
            145deg,
            rgba(255,255,255,0.05),
            rgba(255,255,255,0.015)
        );
    box-shadow:
        0 28px 70px rgba(0,0,0,0.48),
        inset 0 1px 0 rgba(255,255,255,0.065);
}

/* generic cards */
.card {
    position: relative;
    border-radius: 22px;
    border: 1px solid rgba(255,255,255,0.075);
    background: rgba(255,255,255,0.018);
    box-shadow:
        0 20px 50px rgba(0,0,0,0.35),
        inset 0 1px 0 rgba(255,255,255,0.05);
}

/* =========================================================
   FOOTER
   ========================================================= */

footer {
    margin-top: 26px;
    padding: 24px 6px 0;
    display: grid;
    grid-template-columns: 1fr auto auto;
    gap: 24px;
    align-items: center;
    color: #444;
    border-top: 1px solid rgba(255,255,255,0.055);
    font-size: 9px;
    letter-spacing: 0.12em;
}

footer strong {
    color: #777;
    font-size: 11px;
    font-weight: 300;
}

footer div {
    grid-column: 1 / -1;
    padding-top: 4px;
    color: #303030;
}

/* =========================================================
   RESPONSIVE
   ========================================================= */

@media (max-width: 1100px) {
    main {
        width: min(100% - 36px, 1000px);
    }

    .hero {
        grid-template-columns: 1fr;
    }

    .signal-panel {
        border-left: 0;
        border-top: 1px solid rgba(255,255,255,0.07);
    }

    .signal-panel > .signal {
        margin-top: 52px;
    }

    .lower-grid {
        grid-template-columns: 1fr;
    }

    .news-card {
        grid-column: auto;
    }
}

@media (max-width: 700px) {
    main {
        width: calc(100% - 24px);
        padding-top: 12px;
    }

    .topbar {
        padding: 14px;
        border-radius: 18px;
    }

    .topbar .pair {
        display: none;
    }

    .brand h1 {
        font-size: 18px;
    }

    .hero {
        border-radius: 22px;
    }

    .price-panel,
    .signal-panel {
        padding: 22px;
    }

    .price {
        margin-top: 38px;
    }

    .price strong {
        font-size: 48px;
    }

    .provider strong {
        display: none;
    }

    .breakdown-row {
        grid-template-columns: 24px 1fr;
        gap: 10px;
        padding: 14px 0;
    }

    .row-progress,
    .row-result {
        grid-column: 2;
    }

    footer {
        grid-template-columns: 1fr;
        gap: 10px;
    }
}
/* =========================================================
   BUYNOTBUY — VISUAL SYSTEM V2
   Deep / Airy / Living Terminal
   ========================================================= */

/* ---------- GLOBAL ATMOSPHERE ---------- */

html {
    background: #040507;
}

body {
    background:
        radial-gradient(
            circle at 12% 8%,
            rgba(80, 125, 255, 0.075),
            transparent 28%
        ),
        radial-gradient(
            circle at 88% 16%,
            rgba(0, 220, 180, 0.055),
            transparent 25%
        ),
        radial-gradient(
            circle at 50% 82%,
            rgba(155, 90, 255, 0.045),
            transparent 30%
        ),
        #040507;
}

/* subtle technical atmosphere */

body::after {
    content: "";
    position: fixed;
    inset: 0;
    pointer-events: none;
    z-index: -1;
    opacity: 0.22;
    background:
        linear-gradient(
            rgba(255,255,255,0.012) 1px,
            transparent 1px
        ),
        linear-gradient(
            90deg,
            rgba(255,255,255,0.012) 1px,
            transparent 1px
        );
    background-size: 42px 42px;
    mask-image: linear-gradient(
        to bottom,
        black,
        transparent 90%
    );
}


/* =========================================================
   TOP BAR
   ========================================================= */

.topbar {
    position: relative;
    overflow: hidden;
    background:
        linear-gradient(
            135deg,
            rgba(255,255,255,0.065),
            rgba(255,255,255,0.018)
        );
    border: 1px solid rgba(255,255,255,0.085);
    box-shadow:
        0 24px 70px rgba(0,0,0,0.42),
        inset 0 1px 0 rgba(255,255,255,0.08),
        inset 0 -1px 0 rgba(255,255,255,0.025);
    backdrop-filter: blur(24px);
}

.topbar::before {
    content: "";
    position: absolute;
    width: 280px;
    height: 120px;
    left: -100px;
    top: -80px;
    background: rgba(100,145,255,0.12);
    filter: blur(50px);
    pointer-events: none;
}

.brand-copy {
    position: relative;
    z-index: 1;
}

.brand h1 {
    letter-spacing: 0.12em;
}

.main-nav {
    position: relative;
    z-index: 1;
}

.main-nav a {
    transition:
        color 180ms ease,
        background 180ms ease,
        border-color 180ms ease,
        transform 180ms ease;
}

.main-nav a:hover,
.main-nav a.active {
    background: rgba(255,255,255,0.055);
    border-color: rgba(255,255,255,0.10);
    color: #fff;
    transform: translateY(-1px);
}

.settings-button {
    transition:
        background 180ms ease,
        border-color 180ms ease,
        box-shadow 180ms ease,
        transform 180ms ease;
}

.settings-button:hover {
    background: rgba(255,255,255,0.065);
    border-color: rgba(255,255,255,0.14);
    box-shadow: 0 8px 30px rgba(0,0,0,0.28);
    transform: translateY(-1px);
}


/* =========================================================
   HERO — MAIN VOLUME
   ========================================================= */

.hero {
    position: relative;
    overflow: hidden;
    border: 1px solid rgba(255,255,255,0.075);
    background:
        linear-gradient(
            135deg,
            rgba(255,255,255,0.045),
            rgba(255,255,255,0.012)
        );
    box-shadow:
        0 35px 100px rgba(0,0,0,0.48),
        inset 0 1px 0 rgba(255,255,255,0.07);
    backdrop-filter: blur(28px);
}

.hero::before {
    content: "";
    position: absolute;
    width: 520px;
    height: 320px;
    left: -180px;
    top: -180px;
    background: rgba(75,120,255,0.09);
    filter: blur(90px);
    pointer-events: none;
}

.hero::after {
    content: "";
    position: absolute;
    width: 400px;
    height: 300px;
    right: -160px;
    bottom: -180px;
    background: rgba(0,220,180,0.045);
    filter: blur(90px);
    pointer-events: none;
}

.price-panel,
.signal-panel {
    position: relative;
    z-index: 1;
}


/* =========================================================
   PRICE
   ========================================================= */

.price strong {
    text-shadow:
        0 0 30px rgba(255,255,255,0.10),
        0 12px 45px rgba(0,0,0,0.35);
    letter-spacing: -0.045em;
}

.price-subtitle {
    opacity: 0.7;
}

.live-pill {
    background: rgba(0,220,170,0.07);
    border-color: rgba(0,220,170,0.18);
    box-shadow:
        0 0 24px rgba(0,220,170,0.08),
        inset 0 1px 0 rgba(255,255,255,0.05);
}

.live-dot,
.live-pill i,
.status-dot,
.pulse-status-dot {
    box-shadow:
        0 0 10px rgba(0,230,180,0.65),
        0 0 22px rgba(0,230,180,0.22);
}


/* =========================================================
   SIGNAL PANEL
   ========================================================= */

.signal-panel {
    background:
        linear-gradient(
            150deg,
            rgba(255,255,255,0.035),
            rgba(255,255,255,0.008)
        );
}

.signal-panel.long {
    box-shadow:
        inset 1px 0 rgba(0,220,170,0.18),
        inset 0 0 90px rgba(0,220,170,0.025);
}

.signal-panel.short {
    box-shadow:
        inset 1px 0 rgba(255,95,110,0.16),
        inset 0 0 90px rgba(255,95,110,0.025);
}

.signal-copy strong {
    text-shadow: 0 0 28px rgba(255,255,255,0.09);
}

.confidence-ring {
    filter:
        drop-shadow(0 0 14px rgba(255,255,255,0.06));
}

.confidence-inner {
    background:
        radial-gradient(
            circle,
            rgba(255,255,255,0.065),
            rgba(255,255,255,0.012) 65%,
            transparent
        );
    box-shadow:
        inset 0 1px 0 rgba(255,255,255,0.07),
        0 15px 45px rgba(0,0,0,0.3);
}


/* =========================================================
   MARKET CHART
   ========================================================= */

.market-chart {
    position: relative;
    overflow: hidden;
    background:
        radial-gradient(
            circle at 50% 40%,
            rgba(70,110,255,0.035),
            transparent 55%
        ),
        rgba(0,0,0,0.16);
    border: 1px solid rgba(255,255,255,0.055);
    box-shadow:
        inset 0 1px 0 rgba(255,255,255,0.035),
        inset 0 -30px 80px rgba(0,0,0,0.16);
}

.market-chart-svg {
    filter:
        drop-shadow(0 0 10px rgba(90,145,255,0.13));
}

.chart-header,
.chart-bottom {
    position: relative;
    z-index: 2;
}

.chart-legend {
    opacity: 0.82;
}

.legend-ema {
    filter: drop-shadow(0 0 7px rgba(120,150,255,0.45));
}

.current-price-dot {
    filter:
        drop-shadow(0 0 8px rgba(255,255,255,0.8))
        drop-shadow(0 0 20px rgba(100,150,255,0.35));
}

.chart-tooltip {
    background: rgba(8,10,15,0.88);
    border: 1px solid rgba(255,255,255,0.10);
    box-shadow:
        0 18px 45px rgba(0,0,0,0.45),
        inset 0 1px 0 rgba(255,255,255,0.07);
    backdrop-filter: blur(18px);
}


/* =========================================================
   MARKET PULSE
   ========================================================= */

.market-pulse,
.technical-analysis,
.market-activity,
.market-intelligence,
.breakdown-card,
.system-card,
.news-card {
    position: relative;
    overflow: hidden;
    background:
        linear-gradient(
            145deg,
            rgba(255,255,255,0.048),
            rgba(255,255,255,0.012)
        );
    border: 1px solid rgba(255,255,255,0.07);
    box-shadow:
        0 26px 70px rgba(0,0,0,0.32),
        inset 0 1px 0 rgba(255,255,255,0.055);
    backdrop-filter: blur(22px);
}

.market-pulse::before,
.technical-analysis::before,
.market-activity::before,
.market-intelligence::before,
.breakdown-card::before,
.system-card::before,
.news-card::before {
    content: "";
    position: absolute;
    width: 220px;
    height: 150px;
    left: -90px;
    top: -100px;
    background: rgba(90,130,255,0.055);
    filter: blur(60px);
    pointer-events: none;
}

.market-pulse-header,
.technical-header,
.market-activity-header,
.intelligence-header,
.section-title {
    position: relative;
    z-index: 1;
}


/* =========================================================
   PULSE CARDS
   ========================================================= */

.pulse-card {
    position: relative;
    overflow: hidden;
    background:
        linear-gradient(
            145deg,
            rgba(255,255,255,0.055),
            rgba(255,255,255,0.012)
        );
    border: 1px solid rgba(255,255,255,0.07);
    box-shadow:
        0 18px 42px rgba(0,0,0,0.24),
        inset 0 1px 0 rgba(255,255,255,0.055);
    transition:
        transform 220ms ease,
        border-color 220ms ease,
        box-shadow 220ms ease;
}

.pulse-card:hover,
.indicator-card:hover,
.activity-card:hover,
.intelligence-item:hover {
    transform: translateY(-3px);
    border-color: rgba(255,255,255,0.12);
    box-shadow:
        0 24px 55px rgba(0,0,0,0.34),
        inset 0 1px 0 rgba(255,255,255,0.075);
}

.pulse-card.consensus-card {
    background:
        radial-gradient(
            circle at 90% 20%,
            rgba(100,140,255,0.075),
            transparent 42%
        ),
        linear-gradient(
            145deg,
            rgba(255,255,255,0.06),
            rgba(255,255,255,0.012)
        );
}

.pulse-value {
    text-shadow:
        0 0 24px rgba(255,255,255,0.10);
}

.pulse-progress,
.pulse-bar {
    background: rgba(255,255,255,0.045);
}

.pulse-bar {
    box-shadow:
        0 0 14px rgba(100,140,255,0.12);
}


/* =========================================================
   TECHNICAL ANALYSIS
   ========================================================= */

.indicator-card {
    background:
        linear-gradient(
            145deg,
            rgba(255,255,255,0.05),
            rgba(255,255,255,0.01)
        );
    border: 1px solid rgba(255,255,255,0.065);
    box-shadow:
        0 18px 48px rgba(0,0,0,0.25),
        inset 0 1px 0 rgba(255,255,255,0.05);
    transition:
        transform 220ms ease,
        border-color 220ms ease,
        box-shadow 220ms ease;
}

.indicator-main,
.indicator-side-box {
    background: rgba(0,0,0,0.14);
    border: 1px solid rgba(255,255,255,0.045);
}

.technical-track,
.scale-track,
.oscillator-track {
    background: rgba(255,255,255,0.055);
    box-shadow: inset 0 1px 3px rgba(0,0,0,0.35);
}

.scale-fill,
.technical-track > div {
    box-shadow:
        0 0 14px rgba(90,145,255,0.22);
}

.stochastic-track > div {
    box-shadow:
        0 0 14px rgba(255,180,90,0.20);
}


/* =========================================================
   MARKET ACTIVITY
   ========================================================= */

.activity-card {
    background:
        linear-gradient(
            145deg,
            rgba(255,255,255,0.045),
            rgba(255,255,255,0.01)
        );
    border: 1px solid rgba(255,255,255,0.06);
    box-shadow:
        0 18px 45px rgba(0,0,0,0.25),
        inset 0 1px 0 rgba(255,255,255,0.045);
    transition:
        transform 220ms ease,
        border-color 220ms ease,
        box-shadow 220ms ease;
}

.activity-number {
    text-shadow: 0 0 20px rgba(255,255,255,0.08);
}

.activity-bars span {
    box-shadow:
        0 0 9px rgba(80,145,255,0.12);
}


/* =========================================================
   INTELLIGENCE
   ========================================================= */

.intelligence-item,
.intelligence-feature {
    background:
        linear-gradient(
            145deg,
            rgba(255,255,255,0.045),
            rgba(255,255,255,0.01)
        );
    border: 1px solid rgba(255,255,255,0.06);
    box-shadow:
        0 18px 46px rgba(0,0,0,0.24),
        inset 0 1px 0 rgba(255,255,255,0.05);
    transition:
        transform 220ms ease,
        border-color 220ms ease,
        box-shadow 220ms ease;
}

.intelligence-feature {
    background:
        radial-gradient(
            circle at 85% 10%,
            rgba(120,100,255,0.08),
            transparent 40%
        ),
        linear-gradient(
            145deg,
            rgba(255,255,255,0.05),
            rgba(255,255,255,0.01)
        );
}

.intelligence-icon {
    background:
        linear-gradient(
            145deg,
            rgba(255,255,255,0.08),
            rgba(255,255,255,0.02)
        );
    border: 1px solid rgba(255,255,255,0.08);
    box-shadow:
        0 10px 25px rgba(0,0,0,0.25),
        inset 0 1px 0 rgba(255,255,255,0.08);
}


/* =========================================================
   BREAKDOWN / SYSTEM / NEWS
   ========================================================= */

.breakdown-row {
    transition:
        background 180ms ease,
        transform 180ms ease;
}

.breakdown-row:hover {
    background: rgba(255,255,255,0.025);
    transform: translateX(3px);
}

.row-progress {
    background: rgba(255,255,255,0.045);
}

.row-progress > div {
    box-shadow:
        0 0 12px rgba(100,145,255,0.18);
}

.system-list > div {
    background: rgba(255,255,255,0.018);
    border: 1px solid rgba(255,255,255,0.04);
    transition:
        background 180ms ease,
        border-color 180ms ease,
        transform 180ms ease;
}

.system-list > div:hover {
    background: rgba(255,255,255,0.035);
    border-color: rgba(255,255,255,0.08);
    transform: translateX(3px);
}

.system-brand-mark,
.news-icon {
    background:
        linear-gradient(
            145deg,
            rgba(255,255,255,0.09),
            rgba(255,255,255,0.025)
        );
    border: 1px solid rgba(255,255,255,0.08);
    box-shadow:
        0 12px 30px rgba(0,0,0,0.25),
        inset 0 1px 0 rgba(255,255,255,0.08);
}


/* =========================================================
   COLOUR LANGUAGE
   ========================================================= */

.long {
    color: #5ff0c1 !important;
    text-shadow: 0 0 18px rgba(95,240,193,0.18);
}

.short {
    color: #ff7182 !important;
    text-shadow: 0 0 18px rgba(255,113,130,0.16);
}

.neutral {
    color: #a9b3c7 !important;
}

.status-value {
    color: #7ce8c5;
}

.volume-status {
    color: #8baeff;
}


/* =========================================================
   MICRO INTERACTIONS
   ========================================================= */

.pulse-card,
.indicator-card,
.activity-card,
.intelligence-item,
.intelligence-feature,
.breakdown-card,
.system-card,
.news-card {
    will-change: transform;
}

button,
.main-nav a,
.settings-button {
    cursor: pointer;
}

button {
    transition:
        background 180ms ease,
        border-color 180ms ease,
        color 180ms ease,
        transform 180ms ease;
}

button:hover {
    transform: translateY(-1px);
}

button:active {
    transform: translateY(0);
}


/* =========================================================
   SCROLLBAR
   ========================================================= */

* {
    scrollbar-width: thin;
    scrollbar-color: rgba(255,255,255,0.14) transparent;
}

*::-webkit-scrollbar {
    width: 7px;
    height: 7px;
}

*::-webkit-scrollbar-track {
    background: transparent;
}

*::-webkit-scrollbar-thumb {
    background: rgba(255,255,255,0.12);
    border-radius: 99px;
}

*::-webkit-scrollbar-thumb:hover {
    background: rgba(255,255,255,0.20);
}


/* =========================================================
   MOBILE DEPTH
   ========================================================= */

@media (max-width: 700px) {
    body {
        background:
            radial-gradient(
                circle at 50% 0%,
                rgba(80,125,255,0.075),
                transparent 32%
            ),
            #040507;
    }

    .hero,
    .market-pulse,
    .technical-analysis,
    .market-activity,
    .market-intelligence,
    .breakdown-card,
    .system-card,
    .news-card {
        box-shadow:
            0 20px 50px rgba(0,0,0,0.38),
            inset 0 1px 0 rgba(255,255,255,0.055);
    }

    .pulse-card:hover,
    .indicator-card:hover,
    .activity-card:hover,
    .intelligence-item:hover {
        transform: none;
    }
}


