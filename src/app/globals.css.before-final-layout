.breakdown-card,
.system-card,
.news-card,
.market-pulse,
.market-activity,
.technical-analysis,
.market-intelligence {
    transition:
        border-color 220ms ease,
        box-shadow 220ms ease,
        transform 220ms ease;
}

.breakdown-card:hover,
.system-card:hover,
.news-card:hover,
.market-pulse:hover,
.market-activity:hover,
.technical-analysis:hover,
.market-intelligence:hover {
    border-color: rgba(255,255,255,0.12);
    box-shadow:
        0 30px 80px rgba(0,0,0,0.34),
        inset 0 1px 0 rgba(255,255,255,0.045);
}


/* =========================================================
   RESPONSIVE OVERRIDE
   ========================================================= */

@media (max-width: 1000px) {
    .pulse-grid,
    .activity-grid {
        grid-template-columns: repeat(2, minmax(0, 1fr)) !important;
    }

    .pulse-card:nth-child(2n),
    .activity-card:nth-child(2n) {
        border-right: 0;
    }

    .pulse-card:nth-child(n + 3),
    .activity-card:nth-child(n + 3) {
        border-top: 1px solid rgba(255,255,255,0.06);
    }

    .intelligence-grid {
        grid-template-columns: 1fr !important;
    }

    .intelligence-feature {
        border-right: 0;
        border-bottom: 1px solid rgba(255,255,255,0.065);
    }
}

@media (max-width: 700px) {
    .pulse-grid,
    .activity-grid,
    .technical-grid {
        grid-template-columns: 1fr !important;
    }

    .pulse-card,
    .activity-card,
    .technical-card {
        border-right: 0 !important;
        border-bottom: 1px solid rgba(255,255,255,0.065);
    }

    .pulse-card:last-child,
    .activity-card:last-child,
    .technical-card:last-child {
        border-bottom: 0;
    }

    .intelligence-feature {
        min-height: 300px;
        padding: 24px !important;
    }

    .intelligence-item {
        padding: 22px;
    }
}
